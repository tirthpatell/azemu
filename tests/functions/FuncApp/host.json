{
  "version": "2.0",
  "logging": {
    "logLevel": { "default": "Information", "Host.Triggers.Cosmos": "Debug" }
  },
  "extensions": {
    "queues": {
      "maxPollingInterval": "00:00:02",
      "visibilityTimeout": "00:00:02",
      "maxDequeueCount": 3,
      "batchSize": 4
    },
    "blobs": { "maxDegreeOfParallelism": 2 },
    "serviceBus": {
      "maxAutoLockRenewalDuration": "00:01:00",
      "autoCompleteMessages": true
    },
    "eventHubs": {
      "maxEventBatchSize": 10,
      "batchCheckpointFrequency": 1,
      "initialOffsetOptions": { "type": "fromStart" }
    },
    "cosmosDB": { "connectionMode": "Gateway" }
  }
}
